{
  "manifest_version": 3,
  "name": "ByteShield",
  "version": "2.0",
  "description": "Real-Time Edge ML Phishing Detector - Active Intercept Protection",
  "permissions": [
    "activeTab",
    "tabs",
    "offscreen",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "*.wasm",
        "*.mjs",
        "warning.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
